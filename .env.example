# ==============================================================================
# BRT K4: Khepera IV ROS 2 Jazzy & Gazebo Harmonic Simulation Configuration
# ==============================================================================

# Default simulation mode when executing ./run.sh without CLI flags.
# Options:
#   - native : Hardware-accelerated native GUI for capable PCs & Windows 11 WSLg
#   - web    : Browser-based noVNC interface for low-spec PCs, Macs & college demos
KHEPERA_DEFAULT_MODE=native

# Web GUI port for the noVNC browser interface (khepera-web mode).
# IMPORTANT: Port 1947 is strictly forbidden due to conflicts with Sentinel HASP
#            and SafeNet License Manager present on university lab workstations.
# Default: 6080 (Access simulation at: http://localhost:6080)
KHEPERA_WEB_PORT=6080

# Active Docker Compose profile matching default mode ('native' or 'web')
COMPOSE_PROFILES=native

# Virtual desktop resolution for noVNC browser mode
RESOLUTION=1920x1080x24

# ROS 2 Domain ID (0-101) to isolate robot communication in shared laboratory networks
ROS_DOMAIN_ID=0
