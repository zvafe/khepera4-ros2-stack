<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="khepera4_world">
    <!-- Simulation Physics (1000 Hz / 1ms update step, DART physics engine) -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Core Gazebo Harmonic Systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Balanced Environment Lighting -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.2 -1.0</direction>
    </light>

    <!-- Clean Floor / Ground Plane with Standard Surface Friction -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.87 1</ambient>
            <diffuse>0.85 0.85 0.87 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual Goal Target Indicator (Beacon) -->
    <model name="goal_marker">
      <static>true</static>
      <pose>0.5 0.0 0.005 0 0 0</pose>
      <link name="marker_link">
        <!-- Ground target ring -->
        <visual name="target_ring">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.004</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.0 0.9 0.2 0.8</ambient>
            <diffuse>0.0 1.0 0.3 0.8</diffuse>
            <emissive>0.0 0.6 0.2 1.0</emissive>
          </material>
        </visual>
        <!-- Center bullseye dot -->
        <visual name="center_dot">
          <pose>0 0 0.003 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.02</radius>
              <length>0.006</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.1 0.1 1.0</ambient>
            <diffuse>1.0 0.2 0.2 1.0</diffuse>
            <emissive>0.9 0.1 0.1 1.0</emissive>
          </material>
        </visual>
        <!-- Slender vertical flag pin -->
        <visual name="flag_pin">
          <pose>0 0 0.08 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.003</radius>
              <length>0.16</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.8 1.0 1.0</ambient>
            <diffuse>0.2 0.8 1.0 1.0</diffuse>
            <emissive>0.2 0.5 0.9 1.0</emissive>
          </material>
        </visual>
        <!-- Top glowing beacon sphere -->
        <visual name="flag_sphere">
          <pose>0 0 0.16 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.018</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>1.0 0.8 0.0 1.0</ambient>
            <diffuse>1.0 0.9 0.0 1.0</diffuse>
            <emissive>0.9 0.8 0.0 1.0</emissive>
          </material>
        </visual>
      </link>
    </model>

    <!-- Outer Perimeter Walls enclosing 5m x 5m Arena (Height 0.3m, Thickness 0.05m) -->
    <model name="arena_walls">
      <static>true</static>
      <link name="walls_link">
        <!-- North Wall -->
        <collision name="north_collision">
          <pose>0 2.5 0.15 0 0 0</pose>
          <geometry>
            <box><size>5.05 0.05 0.3</size></box>
          </geometry>
        </collision>
        <visual name="north_visual">
          <pose>0 2.5 0.15 0 0 0</pose>
          <geometry>
            <box><size>5.05 0.05 0.3</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.35 0.42 1</ambient>
            <diffuse>0.5 0.55 0.62 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <!-- South Wall -->
        <collision name="south_collision">
          <pose>0 -2.5 0.15 0 0 0</pose>
          <geometry>
            <box><size>5.05 0.05 0.3</size></box>
          </geometry>
        </collision>
        <visual name="south_visual">
          <pose>0 -2.5 0.15 0 0 0</pose>
          <geometry>
            <box><size>5.05 0.05 0.3</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.35 0.42 1</ambient>
            <diffuse>0.5 0.55 0.62 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <!-- East Wall -->
        <collision name="east_collision">
          <pose>2.5 0 0.15 0 0 0</pose>
          <geometry>
            <box><size>0.05 4.95 0.3</size></box>
          </geometry>
        </collision>
        <visual name="east_visual">
          <pose>2.5 0 0.15 0 0 0</pose>
          <geometry>
            <box><size>0.05 4.95 0.3</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.35 0.42 1</ambient>
            <diffuse>0.5 0.55 0.62 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
        <!-- West Wall -->
        <collision name="west_collision">
          <pose>-2.5 0 0.15 0 0 0</pose>
          <geometry>
            <box><size>0.05 4.95 0.3</size></box>
          </geometry>
        </collision>
        <visual name="west_visual">
          <pose>-2.5 0 0.15 0 0 0</pose>
          <geometry>
            <box><size>0.05 4.95 0.3</size></box>
          </geometry>
          <material>
            <ambient>0.3 0.35 0.42 1</ambient>
            <diffuse>0.5 0.55 0.62 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Inclined Ramp / Slope for IMU Accelerometer/Gyro Inclination Testing -->
    <!-- 1.2m long, 0.6m wide, ~10 deg incline, height reaching ~0.18m with side curbs -->
    <model name="inclined_ramp">
      <static>true</static>
      <!-- Knife-edge transition at Z=0 entrance (z0=0.088m, pitch=0.1745 rad ~ 10 deg) -->
      <pose>1.1 1.3 0.088 0 0.1745 0</pose>
      <link name="ramp_link">
        <collision name="collision">
          <geometry>
            <box><size>1.2 0.6 0.03</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.2 0.6 0.03</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.45 0.25 1</ambient>
            <diffuse>0.8 0.5 0.3 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <!-- Left Side Curb / Guide Barrier (0.08m tall to reliably reflect US & IR beams) -->
        <collision name="left_curb_collision">
          <pose>0 0.29 0.025 0 0 0</pose>
          <geometry>
            <box><size>1.2 0.03 0.08</size></box>
          </geometry>
        </collision>
        <visual name="left_curb_visual">
          <pose>0 0.29 0.025 0 0 0</pose>
          <geometry>
            <box><size>1.2 0.03 0.08</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.3 0.15 1</ambient>
            <diffuse>0.6 0.35 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
        <!-- Right Side Curb / Guide Barrier (0.08m tall to reliably reflect US & IR beams) -->
        <collision name="right_curb_collision">
          <pose>0 -0.29 0.025 0 0 0</pose>
          <geometry>
            <box><size>1.2 0.03 0.08</size></box>
          </geometry>
        </collision>
        <visual name="right_curb_visual">
          <pose>0 -0.29 0.025 0 0 0</pose>
          <geometry>
            <box><size>1.2 0.03 0.08</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.3 0.15 1</ambient>
            <diffuse>0.6 0.35 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Raised Platform / Step with Open Drop-off Edge (Cliff Sensor Testing) -->
    <!-- 0.08m tall deck with a gentle West approach ramp and 3 open cliff edges -->
    <!-- Positioned at x=-0.9, y=1.1 giving ~0.55m clearance to the West wall -->
    <model name="raised_platform">
      <static>true</static>
      <link name="platform_link">
        <!-- Main Raised Step Deck (1.0m x 1.0m x 0.08m tall) -->
        <pose>-0.9 1.1 0.04 0 0 0</pose>
        <collision name="deck_collision">
          <geometry>
            <box><size>1.0 1.0 0.08</size></box>
          </geometry>
        </collision>
        <visual name="deck_visual">
          <geometry>
            <box><size>1.0 1.0 0.08</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.5 0.55 1</ambient>
            <diffuse>0.25 0.6 0.65 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
      <link name="approach_ramp_link">
        <!-- Approach ramp on West edge from Z=0 to Z=0.08 (pitch = -0.1337 rad ~ 7.6 deg, knife-edge at Z=0) -->
        <pose>-1.69 1.1 0.030 0 -0.1337 0</pose>
        <collision name="ramp_collision">
          <geometry>
            <box><size>0.6 1.0 0.02</size></box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="ramp_visual">
          <geometry>
            <box><size>0.6 1.0 0.02</size></box>
          </geometry>
          <material>
            <ambient>0.25 0.45 0.5 1</ambient>
            <diffuse>0.3 0.55 0.6 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Internal Obstacles: Boxes & Cylinders for US/IR Scanning -->
    <model name="obstacle_box_1">
      <static>true</static>
      <pose>0.8 -1.1 0.15 0 0 0.26</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.5 0.4 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.5 0.4 0.3</size></box></geometry>
          <material>
            <ambient>0.7 0.35 0.15 1</ambient>
            <diffuse>0.85 0.42 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_box_2">
      <static>true</static>
      <pose>-1.1 -1.2 0.175 0 0 -0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.35 0.35</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.35 0.35</size></box></geometry>
          <material>
            <ambient>0.2 0.5 0.3 1</ambient>
            <diffuse>0.25 0.65 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_barrier">
      <static>true</static>
      <pose>0.0 -1.7 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.15 0.3</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.15 0.3</size></box></geometry>
          <material>
            <ambient>0.4 0.42 0.46 1</ambient>
            <diffuse>0.55 0.58 0.62 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cylinder_1">
      <static>true</static>
      <pose>1.6 -0.3 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.15</radius><length>0.4</length></cylinder></geometry>
          <material>
            <ambient>0.15 0.3 0.65 1</ambient>
            <diffuse>0.2 0.4 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cylinder_2">
      <static>true</static>
      <pose>-0.2 0.6 0.175 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.12</radius><length>0.35</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.12</radius><length>0.35</length></cylinder></geometry>
          <material>
            <ambient>0.5 0.15 0.5 1</ambient>
            <diffuse>0.65 0.2 0.65 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_cylinder_3">
      <static>true</static>
      <pose>-1.5 -0.2 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.10</radius><length>0.3</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.10</radius><length>0.3</length></cylinder></geometry>
          <material>
            <ambient>0.7 0.25 0.25 1</ambient>
            <diffuse>0.85 0.3 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual Floor Patterns & Reflectivity Zones -->
    <model name="floor_patterns">
      <static>true</static>
      <link name="patterns_link">
        <!-- High-Contrast Dark Navigation Line Strip -->
        <visual name="dark_line_x">
          <pose>0.5 0.4 0.0006 0 0 0</pose>
          <geometry><box><size>2.0 0.06 0.001</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="dark_line_y">
          <pose>0.5 0.7 0.0006 0 0 0</pose>
          <geometry><box><size>0.06 0.6 0.001</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.08 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <!-- Low-Reflectivity Dark Matte Surface Patch -->
        <visual name="dark_surface_patch">
          <pose>-1.2 -0.3 0.0005 0 0 0</pose>
          <geometry><box><size>1.0 1.0 0.001</size></box></geometry>
          <material>
            <ambient>0.08 0.08 0.09 1</ambient>
            <diffuse>0.1 0.1 0.12 1</diffuse>
          </material>
        </visual>
        <!-- High-Reflectivity Caution Yellow Zone -->
        <visual name="caution_yellow_zone">
          <pose>0.6 0.6 0.0005 0 0 0</pose>
          <geometry><box><size>0.8 0.8 0.001</size></box></geometry>
          <material>
            <ambient>0.8 0.7 0.05 1</ambient>
            <diffuse>0.95 0.82 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
